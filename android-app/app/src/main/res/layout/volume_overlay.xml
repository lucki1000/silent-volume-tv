<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/overlay_width" android:layout_height="wrap_content" android:orientation="vertical"
    android:gravity="center_horizontal" android:paddingStart="12dp" android:paddingEnd="12dp"
    android:paddingTop="14dp" android:paddingBottom="14dp" android:background="@drawable/overlay_background"
    android:elevation="12dp"
    android:focusable="false" android:importantForAccessibility="noHideDescendants">
    <TextView android:id="@+id/overlay_value" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="24sp" android:textColor="#FFFFFF" android:gravity="center" android:fontFamily="sans-serif-medium" />
    <dev.silentvolume.tv.VerticalVolumeBar android:id="@+id/overlay_progress"
        android:layout_width="28dp" android:layout_height="168dp" android:layout_marginTop="10dp"
        android:padding="0dp" android:indeterminate="false" />
    <ImageView android:id="@+id/overlay_speaker" android:layout_width="20dp" android:layout_height="20dp"
        android:layout_marginTop="12dp" android:src="@drawable/ic_speaker" android:contentDescription="@string/overlay_speaker" />
</LinearLayout>
